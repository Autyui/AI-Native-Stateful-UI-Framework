CODEX_BASE_URL=
CODEX_API_KEY=
LLM_MODEL=openai:gpt-5.3-codex

# --- GitHub context (recommended for real project UI planning) ---
# 什么时候要用：当 repo_url 是 GitHub 仓库，且你希望获得完整代码结构/目录信息（不仅是 README）时。
# 为什么要用：状态栏与锚点质量依赖完整上下文；未配置 token 时容易触发 GitHub 限流，导致规划与回溯准确性下降。
GITHUB_TOKEN=
# 兼容别名（与部分项目命名保持一致）
githubToken=
# 可选：仅临时调试时开启。true 时遇到限流会退化为 README-only 模式（不建议用于正式项目）
GITHUB_ALLOW_README_FALLBACK=false